{
  "name": "guys-domain-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "axios": "^1.7.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.26.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prettify": "yarn prettier --config .prettierrc --check .",
    "prettify:fix": "yarn prettier --config .prettierrc --write .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "test:e2e": "tsc --project tsconfig.e2e.json && playwright test",
    "test:e2e:report": "playwright show-report",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright-core": "1.63.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  }
}
